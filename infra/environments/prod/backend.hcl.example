# Copy to backend.hcl (gitignored) and fill in the bucket/table created by
# the one-time bootstrap in infra/README.md. Then:
#   terraform init -backend-config=backend.hcl

bucket         = "musafir-terraform-state-<your-account-id>"
key            = "musafir/prod/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "musafir-terraform-locks"
encrypt        = true
